# =====================================================================
# Configuración del scanner P2P multi-exchange V1 (solo lectura).
# Copia este archivo a `.env` y ajusta los valores. Todos son OPCIONALES:
# si falta uno, el bot lo pedirá por consola al arrancar usando estos
# valores como predeterminados (Enter = usar el default).
# =====================================================================

# --- Watch targets (pares a vigilar) ---------------------------------
# Criptos a monitorear, separadas por coma. El bot crea un objetivo de vigilancia
# por cada una (todas contra el mismo FIAT) y las recorre en cada barrido.
# Soportadas: USDT, BTC, BNB, ETH, FDUSD, DAI
# OJO: cada moneda añade dos consultas por barrido; marcar muchas aumenta el
# riesgo de que Binance limite las peticiones.
ASSETS=USDT

# ASSET (en singular) es el nombre antiguo, cuando solo se vigilaba una cripto.
# Se sigue leyendo como alias si ASSETS no está, para no romper .env ya escritos.
#ASSET=USDT

FIAT=VND

# Métodos de pago (identifiers de Binance) separados por coma.
# Déjalo vacío para que el bot autodescubra y te muestre un menú numerado.
# Ej: PagoMovil,Banesco,Mercantil
PAY_METHODS=

# --- Parámetros de arbitraje -----------------------------------------
# Fondo disponible, EN MONEDA FIAT (la de FIAT, p. ej. VES). Se usa para filtrar
# los anuncios por sus límites y para dimensionar cuánto operar.
# Va en fiat y no en unidades de la cripto porque es lo único comparable entre
# monedas: 100 tiene sentido en USDT y ninguno en BTC. Las unidades de cada
# cripto las deriva el bot dividiendo este fondo por el precio de compra.
MAX_FIAT=47300000

# MAX_USDT (el fondo en unidades de USDT) YA NO SE LEE: lo sustituye MAX_FIAT.
# Si tu .env aún lo tiene, se ignora sin avisar; bórralo para no confundirte.

# Umbral de ganancia neta (%) a partir del cual se avisa.
THRESHOLD_PCT=1.0

# Buffer (%) que se resta al spread para cubrir fees/slippage.
FEE_BUFFER_PCT=0.0

# Desviación máxima (%) respecto a la mediana del libro para aceptar un anuncio.
# Descarta precios "cebo" atípicos que inflarían el spread. 0 desactiva el filtro.
# Para arbitraje conviene apretado (~2-3%): 15 dejaba pasar cebos muy alejados.
OUTLIER_MAX_DEV_PCT=2.5

# Solo comerciantes verificados (true/false).
MERCHANT_CHECK=false

# --- Polling ----------------------------------------------------------
# Intervalo base entre ciclos, en segundos (se le aplica jitter). Es por BARRIDO
# completo: dentro de un barrido se recorren todos los pares de ASSETS seguidos.
POLL_INTERVAL_S=30

# Filas (anuncios) a pedir por lado y método de pago en cada consulta.
ROWS=20

# --- Almacenamiento ---------------------------------------------------
# Ruta del archivo SQLite donde se guardan las oportunidades.
DB_PATH=opportunities.db

# Ruta del archivo de log.
LOG_PATH=p2p_arb_bot.log

# Ruta del JSON de estado en vivo que escribe el bot y lee el dashboard.
STATUS_PATH=status.json

# Carpeta donde se guarda una imagen (PNG) de cada oportunidad detectada, en el
# instante exacto, para poder confirmar que existió aunque el anuncio ya expirara.
# El nombre lleva fecha + id: AAAAMMDD_HHMMSS_ASSET-FIAT_id.png
SCREENSHOTS_DIR=screenshots

# Activa/desactiva el guardado de esas imágenes (true/false).
# Función SOLO para pruebas locales de desarrollo: en producción déjalo en `false`.
# Actívalo (`true`) únicamente en tu `.env` local si quieres las fichas PNG.
SCREENSHOTS=false

# --- Red / anti-bloqueo ----------------------------------------------
# Objetivo de impersonation TLS de curl_cffi (chrome, chrome131, safari18_0...).
IMPERSONATE=chrome

# Proxy opcional (NO hardcodear credenciales en el código). Formato:
# http://user:pass@host:puerto  — se usa para todas las requests si está presente.
# También se respeta la estándar HTTPS_PROXY si esta está vacía.
PROXY=

# Sonido (beep) al detectar oportunidad (true/false).
BEEP=true

# Modo no interactivo: si es true, NO pregunta nada y usa solo estas vars.
NO_INPUT=false

# --- Dashboard web ----------------------------------------------------
# Host/puerto donde escucha el dashboard.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Contraseña para las acciones protegidas (arrancar/parar/configurar el bot).
# La SUPERVISIÓN es pública; estas acciones exigen login. Si está vacía, no se
# podrá iniciar sesión (el dashboard queda en modo solo-lectura).
DASHBOARD_PASSWORD=

# Secreto para firmar la cookie de sesión. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacío se genera uno al vuelo (las sesiones no sobreviven a reinicios).
DASHBOARD_SECRET=

# Ruta del .env que edita el dashboard al guardar la configuración.
ENV_PATH=.env

# Ruta del SQLite donde el DASHBOARD registra las operaciones que ejecutaste a
# mano (compras/ventas cerradas y las que no lograste cerrar). Es un fichero
# APARTE de DB_PATH a propósito: SQLite bloquea el fichero entero, no la tabla, y
# si el dashboard escribiera en la misma base que el bot se pelearían por el lock.
# El bot no lee ni escribe este fichero.
TRADES_DB_PATH=trades.db

# Ruta del pidfile con el que el dashboard controla el bot como subproceso. Vive
# en disco para sobrevivir a reinicios del propio dashboard. Si se deja vacío, se
# usa bot.pid junto a DB_PATH.
BOT_PIDFILE=

# --- Scanner multi-exchange V1 (default); false conserva monitor legado ---
SCANNER_V1=true
EXCHANGES=Binance,OKX,Bybit
# Para probar el fallo aislado: EXCHANGES=Binance,OKX,Bybit,BingX + flag true.
# No hay endpoint BingX verificado: el adaptador informa error, nunca inventa ads.
BINGX_ENABLED=false

# Fiabilidad de ejecución: NO es una evaluación AML ni bancaria.
MIN_COMPLETION_RATE=0
MIN_COMPLETED_ORDERS=0
# 0 permite anuncios sin plazo conocido; >0 rechaza dato ausente.
MAX_PAYMENT_MINUTES=60
EXCLUDE_MERCHANTS=
# Límite TOTAL de contrapartes de compra + venta.
MAX_COUNTERPARTIES=8
QUOTE_TTL_S=45

# Costes porcentuales independientes; hipótesis configurables, no tasas oficiales.
P2P_BUY_FEE_PCT=0
P2P_SELL_FEE_PCT=0
TRADING_FEE_PCT=0
TAX_PCT=0
SAFETY_BUFFER_PCT=0.2
COUNTERPARTY_PENALTY_PCT=0.02
# Snapshot manual: necesita AMBOS exchanges para cada red y timestamp con zona.
# Sin snapshot vigente las rutas se muestran RECHAZADAS, no ejecutables gratis.
NETWORK_COST_TTL_S=86400
NETWORK_COSTS_JSON=[]
# Ejemplo ilustrativo, sustituir fee/min/estado/timestamp con datos verificados:
# NETWORK_COSTS_JSON=[{"exchange":"Binance","asset":"USDT","network":"TRC20","deposit_enabled":true,"withdraw_enabled":true,"withdraw_fee":"1","min_withdrawal":"10","timestamp":"2026-10-31T00:00:00+00:00"},{"exchange":"OKX","asset":"USDT","network":"TRC20","deposit_enabled":true,"withdraw_enabled":true,"withdraw_fee":"1","min_withdrawal":"10","timestamp":"2026-10-31T00:00:00+00:00"}]

# --- Metadata automática de redes (opcional, solo lectura) -----------------
# Si no hay credenciales, se conserva NETWORK_COSTS_JSON manual.
# Si se configuran, deben ser claves SOLO LECTURA. NO habilitar Trade/Withdraw.
NETWORK_METADATA_REFRESH_S=600

BINANCE_API_KEY=
BINANCE_API_SECRET=
# Override opcional para región/test; vacío = https://api.binance.com
BINANCE_API_BASE_URL=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Override opcional por región; vacío = https://openapi.okx.com
OKX_API_BASE_URL=

BYBIT_API_KEY=
BYBIT_API_SECRET=
# Override opcional por región; vacío = https://api.bybit.com
BYBIT_API_BASE_URL=

# Persistencia CONTINUA del margen antes del aviso; ambos mínimos obligatorios.
ALERT_MIN_SCANS=3
ALERT_MIN_SECONDS=30
ALERT_COOLDOWN_SECONDS=300
# Opcional; no se registra el token en logs. Requiere egress a api.telegram.org.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
